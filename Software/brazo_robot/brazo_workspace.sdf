<?xml version="1.0"?>
<sdf version="1.9">
  <world name="brazo_workspace">

    <!-- ==================== Physics ==================== -->
    <!-- All world objects are visual-only (no collision). The robot arm is
         fixed to world via world_to_base and is position-controlled — it has
         no need to collide with the environment. Removing world collision keeps
         ODE's dxHashSpace empty, avoiding the AABB integer-overflow crash that
         occurs when dartsim's GzOdeCollisionDetector processes our box
         primitives alongside the robot's uncollided dynamic bodies. -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- ==================== Plugins ==================== -->
    <plugin name="gz::sim::systems::Physics"          filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands"     filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin filename="gz-sim-sensors-system"          name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ==================== Lighting ==================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light type="point" name="overhead">
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>6</range>
        <linear>0.05</linear>
        <constant>0.1</constant>
        <quadratic>0.0</quadratic>
      </attenuation>
    </light>

    <!-- ==================== Ground (visual only) ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20 20 0.2</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Work surface 1.1 × 1.1 m (visual only) ==================== -->
    <model name="work_surface">
      <static>true</static>
      <pose>0 0 -0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.1 1.1 0.01</size></box></geometry>
          <material>
            <ambient>0.93 0.93 0.93 1</ambient>
            <diffuse>0.93 0.93 0.93 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Border frame — four thin strips, 20 mm tall, 3 mm wide (visual only) -->
    <model name="border_north">
      <static>true</static>
      <pose>0 0.5515 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.103 0.003 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="border_south">
      <static>true</static>
      <pose>0 -0.5515 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.103 0.003 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="border_east">
      <static>true</static>
      <pose>0.5515 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.003 1.103 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="border_west">
      <static>true</static>
      <pose>-0.5515 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.003 1.103 0.02</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== Ping-pong ball recipients (Baseepin.STL, visual only) ============
         STL units: mm  →  scale 0.001.
         STL bounding box (mm): X[11.72,171.72]  Y[-143.12,136.88]  Z[985,1155]
         Visual pose with roll=π flips the mesh right-side-up (physical base at Z-max=1155mm).
         After rolling π: negate Y and Z of mesh coords, then:
           dx = -cx_m        = -0.09172   (centre X)
           dy = +cy_m        = -0.00312   (centre Y negated)
           dz = +zmax_m      = +1.155     (bring physical base to z=0)
         Positions from robot centre (layout drawing, mm→m):
           North (+Y): 230 mm   East  (+X): 241 mm
           South (-Y): 330 mm   West  (-X): 240 mm
    ===========================================================================================-->

    <!-- Recipient NORTH  +Y = 230 mm -->
    <model name="recipient_north">
      <static>true</static>
      <pose>-0.0465 0.230 0   0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <pose>-0.09172 -0.00312 1.155   3.1416 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/arlo/Ros_projects/Ros2/Baseepin.STL</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Recipient EAST  +X = 241 mm  (yaw 180°) -->
    <model name="recipient_east">
      <static>true</static>
      <pose>0.2411 0.0465 0   0 0 3.1416</pose>
      <link name="link">
        <visual name="visual">
          <pose>-0.09172 -0.00312 1.155   3.1416 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/arlo/Ros_projects/Ros2/Baseepin.STL</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Recipient SOUTH  -Y = 330 mm  (yaw -90°) -->
    <model name="recipient_south">
      <static>true</static>
      <pose>0.0465 -0.330 0   0 0 -1.5708</pose>
      <link name="link">
        <visual name="visual">
          <pose>-0.09172 -0.00312 1.155   3.1416 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/arlo/Ros_projects/Ros2/Baseepin.STL</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Recipient WEST  -X = 240 mm  (yaw 0°) -->
    <model name="recipient_west">
      <static>true</static>
      <pose>-0.240 -0.0465 0   0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <pose>-0.09172 -0.00312 1.155   3.1416 0 0</pose>
          <geometry>
            <mesh>
              <uri>file:///home/arlo/Ros_projects/Ros2/Baseepin.STL</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
